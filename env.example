DISCORD_TOKEN=
COMMAND_PREFIX=f.

# Set DATABASE_URL for managed PostgreSQL. Leave empty to use SQLite.
DATABASE_URL=
DB_PATH=phonebooth.db
DATABASE_POOL_SIZE=5
PG_STATEMENT_CACHE_SIZE=0
TRUSTED_MOD_IDS=

QUEUE_TIMEOUT=10
REPORT_LOG_CHANNEL_ID=0
GIF_REVIEW_CHANNEL_ID=0
LOG_CHANNEL_ID=0
TOPGG_TOKEN=
SUPPORT_URL=https://discord.gg/your-server
TOPGG_URL=https://top.gg/bot/your-bot-id
PRIVACY_URL=https://example.com/privacy
TOS_URL=https://example.com/terms
SHARD_COUNT=0

# Weekly encrypted SQLite backup settings.
BACKUP_DIR=F:\Backups\Fliphone
BACKUP_KEY_PATH=F:\Secrets\fliphone-backup.key
